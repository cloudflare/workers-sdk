{
	"printWidth": 80,
	"singleQuote": false,
	"semi": true,
	"useTabs": true,
	"trailingComma": "es5",
	"sortImports": {
		"groups": ["builtin", "external", "parent", "sibling", "index", "type"],
		"newlinesBetween": false,
	},
	"sortTailwindcss": {},
	"sortPackageJson": {},
	"overrides": [
		{
			"files": ["packages/vite-plugin-cloudflare/README.md"],
			"options": {
				"useTabs": false,
				"trailingComma": "all",
			},
		},
		{
			"files": [".changeset/*.md"],
			"options": {
				"proseWrap": "never",
			},
		},
	],
	"ignorePatterns": [
		"CHANGELOG.md",
		"packages/vite-plugin-cloudflare/playground/prisma/src/generated",
		"dist-functions",
		"vscode.d.ts",
		"vscode.*.d.ts",
		".e2e-logs*",
		".github/pull_request_template.md",
		"packages/vite-plugin-cloudflare/playground/**/*.d.ts",
		"fixtures/**/worker-configuration.d.ts",
		"packages/**/worker-configuration.d.ts",
	],
}
