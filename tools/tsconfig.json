{
	"root": true,
	"extends": "@cloudflare/workers-tsconfig/tsconfig.json",
	"include": ["**/*.ts", "**/*.js", "**/*.mts"],
	"exclude": ["node_modules"],
	"compilerOptions": {
		"rootDir": "..",
		"module": "preserve",
		"allowJs": true,
		"outDir": "dist",
		"types": ["node"],
		"resolveJsonModule": true
	}
}
