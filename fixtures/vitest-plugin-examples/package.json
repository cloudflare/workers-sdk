{
	"name": "@fixture/vitest-plugin-examples",
	"private": true,
	"type": "module",
	"scripts": {
		"cf-typegen": "pnpm run \"/^typegen:.*/\"",
		"check:type": "pnpm run \"/^typegen:cf:/\" && node tsc-all.mjs",
		"list": "vitest list",
		"test": "vitest",
		"test:ci": "vitest run",
		"typegen:cf:ai-vectorize": "cd ai-vectorize && cf workers types --include-runtime=false",
		"typegen:cf:basics-unit-integration-self": "cd basics-unit-integration-self && cf workers types --include-runtime=false",
		"typegen:cf:container-app": "cd container-app && cf workers types --include-runtime=false",
		"typegen:cf:d1": "cd d1 && cf workers types --include-runtime=false",
		"typegen:cf:durable-objects": "cd durable-objects && cf workers types --include-runtime=false",
		"typegen:cf:durable-objects-exports": "cd durable-objects-exports && cf workers types --include-runtime=false",
		"typegen:cf:context-exports": "cd context-exports/src && cf workers types --include-runtime=false",
		"typegen:cf:dynamic-import": "cd dynamic-import && cf workers types --include-runtime=false",
		"typegen:cf:hyperdrive": "cd hyperdrive && cf workers types --include-runtime=false",
		"typegen:cf:images": "cd images && cf workers types --include-runtime=false",
		"typegen:cf:kv-r2-caches": "cd kv-r2-caches && cf workers types --include-runtime=false",
		"typegen:cf:module-resolution": "cd module-resolution && cf workers types --include-runtime=false",
		"typegen:cf:multiple-workers:api": "cd multiple-workers/api-service && cf workers types --include-runtime=false",
		"typegen:cf:new-config": "cd new-config && cf workers types --include-runtime=false",
		"typegen:cf:pipelines": "cd pipelines && cf workers types --include-runtime=false",
		"typegen:cf:queues": "cd queues && cf workers types --include-runtime=false",
		"typegen:cf:request-mocking": "cd request-mocking && cf workers types --include-runtime=false",
		"typegen:cf:reset": "cd reset && cf workers types --include-runtime=false",
		"typegen:cf:rpc": "cd rpc && cf workers types --include-runtime=false",
		"typegen:cf:web-assembly": "cd web-assembly && cf workers types --include-runtime=false",
		"typegen:cf:workers-assets": "cd workers-assets && cf workers types --include-runtime=false",
		"typegen:cf:workers-assets-no-dir": "cd workers-assets-no-dir && cf workers types --include-runtime=false",
		"typegen:cf:workflows": "cd workflows && cf workers types --include-runtime=false",
		"typegen:cf:workflows-exports": "cd workflows-exports && cf workers types --include-runtime=false",
		"typegen:multiple-workers:auth": "wrangler types ./multiple-workers/auth-service/src/env.d.ts -c ./multiple-workers/auth-service/wrangler.jsonc --no-include-runtime",
		"typegen:multiple-workers:database": "wrangler types ./multiple-workers/database-service/src/env.d.ts -c ./multiple-workers/database-service/wrangler.jsonc --no-include-runtime"
	},
	"devDependencies": {
		"@better-auth/stripe": "^1.4.6",
		"@cloudflare/containers": "^0.2.2",
		"@cloudflare/vitest-plugin": "workspace:*",
		"@cloudflare/workers-types": "catalog:default",
		"@microlabs/otel-cf-workers": "1.0.0-rc.45",
		"@msw/cloudflare": "0.0.1",
		"@types/mime-types": "^3.0.1",
		"@types/node": "catalog:default",
		"@types/nunjucks": "^3.2.6",
		"@vitest/ui": "catalog:default",
		"better-auth": "^1.4.6",
		"cf": "catalog:default",
		"cjs-wasm-module-dep": "file:./module-resolution/vendor/cjs-wasm-module-dep",
		"discord-api-types": "0.37.98",
		"esm-dep": "file:./module-resolution/vendor/esm-dep",
		"ext-dep": "file:./module-resolution/vendor/ext-dep",
		"jose": "^5.9.3",
		"mime-types": "^2.1.35",
		"miniflare": "workspace:*",
		"msw": "catalog:default",
		"nunjucks": "^3.2.4",
		"stripe": "^20.0.0",
		"toucan-js": "4.0.0",
		"typescript": "catalog:default",
		"vite": "catalog:default",
		"vitest": "catalog:default",
		"wasm-module-dep": "file:./module-resolution/vendor/wasm-module-dep",
		"wrangler": "workspace:*"
	}
}
