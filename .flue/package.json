{
	"name": "@cloudflare/workers-sdk-flue",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "flue build",
		"cf-typegen": "wrangler types --config dist/workers_sdk_flue/wrangler.json --include-runtime=false",
		"check:type": "tsc",
		"dev": "flue dev",
		"smoke": "flue run workspace-smoke --input '{\"message\":\"Verify the durable workspace.\"}' --header \"Authorization: Bearer $FLUE_BEARER_TOKEN\""
	},
	"devDependencies": {
		"@cloudflare/codemode": "0.4.3",
		"@cloudflare/shell": "0.4.1",
		"@cloudflare/workers-types": "catalog:default",
		"@flue/cli": "1.0.0-beta.9",
		"@flue/github": "1.0.0-beta.1",
		"@flue/runtime": "1.0.0-beta.9",
		"@octokit/rest": "22.0.1",
		"agents": "0.14.2",
		"hono": "4.12.31",
		"typescript": "catalog:default",
		"valibot": "1.4.2",
		"vite": "8.1.5",
		"wrangler": "workspace:*",
		"zod": "4.3.6"
	},
	"volta": {
		"extends": "../package.json"
	}
}
