{
	"name": "@cloudflare/workers-sdk",
	"version": "0.0.0",
	"private": true,
	"description": "Maintenance workspace for Cloudflare Vite plugin v1",
	"homepage": "https://github.com/cloudflare/workers-sdk#readme",
	"bugs": {
		"url": "https://github.com/cloudflare/workers-sdk/issues"
	},
	"license": "MIT OR Apache-2.0",
	"author": "wrangler@cloudflare.com",
	"scripts": {
		"build": "dotenv -- turbo build --filter @cloudflare/vite-plugin...",
		"dev": "dotenv -- turbo dev",
		"test": "pnpm test:ci",
		"test:ci": "dotenv -- turbo test:ci --filter @cloudflare/vite-plugin... --filter @cloudflare/lint-config-shared",
		"test:fixtures": "dotenv -- turbo test:ci --filter \"@fixture/*\"",
		"test:playgrounds": "pnpm --filter @vite-plugin-cloudflare/playground test:ci",
		"test:e2e": "dotenv -- turbo test:e2e --filter @cloudflare/vite-plugin",
		"check": "pnpm check:changesets && pnpm check:workflows && pnpm check:pinned-deps && pnpm check:package-deps && pnpm check:lint && pnpm check:type && pnpm check:format",
		"check:changesets": "node -r esbuild-register tools/deployments/validate-changesets.ts",
		"check:workflows": "node -r esbuild-register tools/github-workflow-helpers/validate-action-pinning.ts",
		"check:pinned-deps": "node -r esbuild-register tools/deployments/validate-pinned-dependencies.ts",
		"check:package-deps": "pnpm build && node -r esbuild-register tools/deployments/validate-package-dependencies.ts",
		"check:lint": "oxlint --deny-warnings --type-aware",
		"check:type": "dotenv -- turbo check:type type:tests",
		"check:format": "oxfmt --check",
		"fix": "oxlint --fix --type-aware && pnpm prettify",
		"prettify": "oxfmt",
		"version-packages": "pnpm exec changeset version && pnpm install --lockfile-only --ignore-scripts && pnpm prettify",
		"release": "pnpm exec changeset publish --tag v1"
	},
	"dependencies": {
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.29.7",
		"@changesets/parse": "^0.4.1",
		"@cloudflare/lint-config-shared": "workspace:*",
		"@types/node": "catalog:default",
		"@types/semver": "7.8.0",
		"cross-env": "^7.0.3",
		"dotenv-cli": "^7.3.0",
		"esbuild": "catalog:default",
		"esbuild-register": "^3.5.0",
		"eslint-plugin-turbo": "^2.8.17",
		"jsonc-parser": "catalog:default",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.56.0",
		"oxlint-tsgolint": "^0.17.0",
		"semver": "7.8.5",
		"tinyglobby": "0.2.17",
		"tree-kill": "catalog:default",
		"turbo": "^2.7.2",
		"typescript": "catalog:default",
		"vite": "catalog:default",
		"vitest": "catalog:default"
	},
	"engines": {
		"node": ">=22.0.0",
		"pnpm": "^10.33.0"
	},
	"volta": {
		"node": "22.22.1",
		"pnpm": "10.33.0"
	},
	"packageManager": "pnpm@10.33.0"
}
