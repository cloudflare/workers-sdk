{
  "name": "teammarysy-bot",
  "version": "1.0.0",
  "description": "TeamMarySy Telegram Bot on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "vitest run",
    "secret:token": "wrangler secret put TELEGRAM_BOT_TOKEN",
    "secret:webhook": "wrangler secret put WEBHOOK_SECRET",
    "secret:owner": "wrangler secret put OWNER_TELEGRAM_ID",
    "webhook:set": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250701.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^3.70.0"
  }
}
