{
	"compilerOptions": {
		"target": "ESNext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"skipLibCheck": true,
		"esModuleInterop": true,
		"strict": true,
		"declaration": true,
		"resolveJsonModule": true,
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true
	},
	"include": ["src/**/*"]
}
