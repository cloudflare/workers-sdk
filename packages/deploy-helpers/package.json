{
	"name": "@cloudflare/deploy-helpers",
	"version": "0.28.0",
	"description": "Internal deploy helpers for workers-sdk. Not intended for external use — APIs may change without notice.",
	"homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/deploy-helpers#readme",
	"bugs": {
		"url": "https://github.com/cloudflare/workers-sdk/issues"
	},
	"license": "MIT OR Apache-2.0",
	"author": "workers-devprod@cloudflare.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudflare/workers-sdk.git",
		"directory": "packages/deploy-helpers"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./context": {
			"import": "./dist/context.mjs",
			"types": "./dist/context.d.mts"
		},
		"./dev-vars": {
			"import": "./dist/dev-vars.mjs",
			"types": "./dist/dev-vars.d.mts"
		},
		"./miniflare-options": {
			"import": "./dist/miniflare-options.mjs",
			"types": "./dist/miniflare-options.d.mts"
		},
		"./pages-assets": {
			"import": "./dist/pages-assets.mjs",
			"types": "./dist/pages-assets.d.mts"
		},
		"./create-worker-upload-form": {
			"import": "./dist/create-worker-upload-form.mjs",
			"types": "./dist/create-worker-upload-form.d.mts"
		},
		"./startup-profile": {
			"import": "./dist/startup-profile.mjs",
			"types": "./dist/startup-profile.d.mts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check:type": "tsc -p ./tsconfig.json && tsc -p ./tsconfig.pages-assets.json",
		"deploy": "echo 'no deploy'",
		"dev": "concurrently -c black,blue,cyan --kill-others-on-fail false \"pnpm tsdown --watch\" \"pnpm exec tsc -p tsconfig.json --watch --preserveWatchOutput\" \"pnpm exec tsc -p tsconfig.pages-assets.json --watch --preserveWatchOutput\"",
		"test": "vitest",
		"test:ci": "vitest run",
		"type:tests": "tsc -p ./tests/tsconfig.json"
	},
	"dependencies": {
		"@cloudflare/cli-shared-helpers": "workspace:*",
		"@cloudflare/config": "workspace:*",
		"@cloudflare/containers-shared": "workspace:*",
		"@cloudflare/workers-utils": "workspace:*",
		"chalk": "catalog:default",
		"chokidar": "4.0.3",
		"command-exists": "catalog:default",
		"devtools-protocol": "0.0.1182435",
		"dotenv": "catalog:default",
		"dotenv-expand": "12.0.2",
		"mime": "3.0.0",
		"miniflare": "workspace:*",
		"p-queue": "9.0.0",
		"pretty-bytes": "6.1.1",
		"undici": "catalog:default",
		"ws": "catalog:default"
	},
	"devDependencies": {
		"@cloudflare/pages-shared": "workspace:*",
		"@cloudflare/workers-shared": "workspace:*",
		"@cloudflare/workers-tsconfig": "workspace:*",
		"@cloudflare/workers-types": "catalog:default",
		"@cspotcode/source-map-support": "0.8.1",
		"@types/command-exists": "^1.2.0",
		"@types/json-diff": "^1.0.3",
		"@types/mime": "^3.0.4",
		"@types/node": "catalog:default",
		"@types/ws": "^8.5.7",
		"concurrently": "^8.2.2",
		"esbuild": "catalog:default",
		"hash-wasm": "4.13.0",
		"json-diff": "^1.0.6",
		"ts-dedent": "^2.2.0",
		"tsdown": "catalog:default",
		"typescript": "catalog:default",
		"vitest": "catalog:default"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"workers-sdk": {
		"prerelease": true
	}
}
