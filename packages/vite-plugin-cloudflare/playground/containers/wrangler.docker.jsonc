{
	"name": "dockerfile-container-app",
	"main": "./src/index.ts",
	"compatibility_date": "2025-04-03",
	"containers": [
		{
			// Named Container image built from the local Dockerfile
			"class_name": "Container",
			"name": "dockerfile-http",
			"scheduling_policy": "durable_object",
			"images": {
				"app": { "dockerfile": "./Dockerfile" },
			},
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "Container",
				"name": "CONTAINER",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Container"],
		},
	],
}
