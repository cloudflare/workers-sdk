{
	"name": "@playground/workflows",
	"private": true,
	"type": "module",
	"scripts": {
		"build:default": "vite build --app",
		"build:exports": "vite build -c ./vite.config.exports.ts",
		"cf-typegen": "wrangler types -c ./wrangler.exports.jsonc --no-include-runtime",
		"check:type": "tsc --build",
		"dev": "vite dev",
		"dev:exports": "vite dev -c ./vite.config.exports.ts",
		"preview": "vite preview",
		"preview:exports": "vite preview -c ./vite.config.exports.ts"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "workspace:*",
		"@cloudflare/workers-tsconfig": "workspace:*",
		"@cloudflare/workers-types": "catalog:default",
		"typescript": "catalog:default",
		"vite": "catalog:default",
		"wrangler": "workspace:*"
	}
}
