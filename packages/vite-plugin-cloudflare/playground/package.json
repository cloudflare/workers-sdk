{
	"name": "@vite-plugin-cloudflare/playground",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check:type": "tsc --build",
		"playwright:install": "pnpm playwright install chromium",
		"pretest:ci": "pnpm playwright:install",
		"pretest:serve": "pnpm playwright:install",
		"test:ci": "pnpm test:ci:serve && pnpm test:ci:build",
		"test:ci:build": "cross-env VITE_TEST_BUILD=1 vitest run -c vitest.config.e2e.ts",
		"test:ci:rsbuild:build": "cross-env CLOUDFLARE_TEST_BUNDLER=rsbuild VITE_TEST_BUILD=1 vitest run -c vitest.config.e2e.rsbuild.ts",
		"test:ci:rsbuild:serve": "cross-env CLOUDFLARE_TEST_BUNDLER=rsbuild vitest run -c vitest.config.e2e.rsbuild.ts",
		"test:ci:serve": "vitest run -c vitest.config.e2e.ts",
		"test:serve": "pnpm test:ci:serve"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.721.0",
		"@aws-sdk/s3-request-presigner": "^3.721.0",
		"@cloudflare/rsbuild-plugin": "workspace:*",
		"@cloudflare/vite-plugin": "workspace:*",
		"@cloudflare/workers-tsconfig": "workspace:*",
		"@rsbuild/core": "^2.2.13",
		"@rsbuild/plugin-basic-ssl": "^2.0.0",
		"@rsbuild/plugin-react": "^2.1.1",
		"playwright-chromium": "catalog:default",
		"semver": "^7.7.1",
		"ts-dedent": "^2.2.0",
		"typescript": "catalog:default",
		"undici": "catalog:default",
		"vitest": "catalog:default"
	}
}
