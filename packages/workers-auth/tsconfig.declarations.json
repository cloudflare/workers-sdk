{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "../..",
		"outDir": "emitted-types",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"noCheck": true,
		"incremental": false
	},
	"files": [
		"src/index.ts",
		"src/wrangler/index.ts",
		"src/cf/index.ts",
		"src/test-helpers/index.ts"
	],
	"include": ["src/**/*.d.ts"]
}
