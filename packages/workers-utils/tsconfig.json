{
	"extends": "@cloudflare/workers-tsconfig/tsconfig.json",
	"compilerOptions": {
		"module": "esnext",
		"types": ["node"],
		"tsBuildInfoFile": ".tsbuildinfo",
		"allowImportingTsExtensions": true
	},
	"include": ["**/*.ts", "**/*.js"],
	"exclude": ["dist", "node_modules", "**/__tests__", "**/*.test.ts"]
}
