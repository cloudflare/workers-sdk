{
	"name": "@cloudflare/test-harness",
	"version": "0.0.0",
	"description": "Run a project's Build Output in tests, with Wrangler's createTestHarness API. This is not yet stable enough for external use — APIs may change without notice.",
	"homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/test-harness#readme",
	"bugs": {
		"url": "https://github.com/cloudflare/workers-sdk/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudflare/workers-sdk.git",
		"directory": "packages/test-harness"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check:type": "tsc",
		"dev": "tsdown --watch",
		"test:ci": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cloudflare/build-output-utils": "workspace:*",
		"miniflare": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/cli-shared-helpers": "workspace:*",
		"@cloudflare/remote-bindings": "workspace:*",
		"@cloudflare/workers-auth": "workspace:*",
		"@cloudflare/workers-tsconfig": "workspace:*",
		"@cloudflare/workers-types": "catalog:default",
		"@cloudflare/workers-utils": "workspace:*",
		"@cloudflare/workflows-shared": "workspace:*",
		"tsdown": "0.16.3",
		"typescript": "catalog:default",
		"vitest": "catalog:default"
	},
	"peerDependencies": {
		"@cloudflare/workers-types": "catalog:default"
	},
	"peerDependenciesMeta": {
		"@cloudflare/workers-types": {
			"optional": true
		}
	},
	"workers-sdk": {
		"prerelease": true
	}
}
