{
	"root": true,
	"extends": "@cloudflare/workers-tsconfig/tsconfig.json",
	"include": [
		"*.ts",
		"*.mts",
		"e2e/**/*.ts",
		"scripts/**/*.ts",
		"src/**/*.ts",
		// Only include the template config files that C3 imports; the rest are
		// source files for generated projects.
		"templates/**/c3.ts",
		"templates/**/experimental?c3.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"scripts/snippets/*",
		"e2e/tests/frameworks/fixtures/*"
	],
	"compilerOptions": {
		"rootDir": "../..",
		"target": "ESNext",
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowJs": true,
		"strict": true,
		"esModuleInterop": true,
		"types": ["node"],
		"resolveJsonModule": true,
		"paths": {
			"helpers/*": ["./src/helpers/*"],
			"templates/*": ["./templates/*"],
			"templates-experimental/*": ["./templates-experimental/*"],
			"frameworks/*": ["./src/frameworks/*"],
			"types": ["./src/types.ts"]
		}
	}
}
