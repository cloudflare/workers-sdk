{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "../..",
		"outDir": "emitted-types",
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"noCheck": true,
		"incremental": false
	},
	"files": [
		"index.ts",
		"args.ts",
		"colors.ts",
		"command.ts",
		"error.ts",
		"gitignore.ts",
		"interactive.ts",
		"packages.ts",
		"streams.ts"
	],
	"include": ["src/**/*.d.ts"]
}
