{
	"name": "@cloudflare/workers-dev-shared",
	"version": "0.0.0",
	"private": true,
	"description": "Bundler-agnostic helpers shared by the Cloudflare Vite and Rsbuild plugins.",
	"homepage": "https://github.com/cloudflare/workers-sdk/tree/main/packages/workers-dev-shared#readme",
	"bugs": {
		"url": "https://github.com/cloudflare/workers-sdk/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/cloudflare/workers-sdk.git",
		"directory": "packages/workers-dev-shared"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "tsdown",
		"check:type": "tsc && tsc -p tsconfig.worker.json",
		"dev": "tsdown --watch",
		"test:ci": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cloudflare/config": "workspace:*",
		"@cloudflare/runtime-types": "workspace:*",
		"@cloudflare/unenv-preset": "workspace:*",
		"miniflare": "workspace:*",
		"mlly": "^1.7.4",
		"unenv": "2.0.0-rc.24"
	},
	"devDependencies": {
		"@cloudflare/build-output-utils": "workspace:*",
		"@cloudflare/containers-shared": "workspace:*",
		"@cloudflare/remote-bindings": "workspace:*",
		"@cloudflare/workers-shared": "workspace:*",
		"@cloudflare/workers-tsconfig": "workspace:*",
		"@cloudflare/workers-types": "catalog:default",
		"@cloudflare/workers-utils": "workspace:*",
		"@remix-run/node-fetch-server": "^0.8.0",
		"@types/node": "catalog:default",
		"@types/ws": "^8.5.13",
		"defu": "^6.1.4",
		"get-port": "^7.1.0",
		"picocolors": "^1.1.1",
		"tsdown": "0.16.3",
		"typescript": "catalog:default",
		"vitest": "catalog:default",
		"ws": "catalog:default"
	}
}
