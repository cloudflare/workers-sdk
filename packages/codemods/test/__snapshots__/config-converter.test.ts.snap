 * @see https://developers.cloudflare.com/workers/wrangler/configuration/#previews
 */
throw new Error("Migration incomplete. Resolve every cf migrate TODO in \`cloudflare.config.ts\`.");

export default defineConfig((ctx) => {
	switch (ctx.mode) {
		case "staging": {
			if (ctx.isPreview) {
				return {
					complianceRegion: "fedramp-high",
					worker: {
						name: "example-worker-staging",
						compatibilityDate: "2026-09-23",
						env: {
							MODE: bindings.text("preview"),
						},
					},
				};
			}
			return {
				complianceRegion: "fedramp-high",
				worker: {
					name: "example-worker-staging",
					compatibilityDate: "2026-09-23",
					env: {
						MODE: bindings.text("staging"),
						LOGS: bindings.logfwdr({
							destination: "logs",
						}),
					},
					/**
					 * TODO(@cloudflare): cf migrate: Preview configuration was converted to \`ctx.isPreview\` handling. Review the generated Preview branch.
					 * @see https://developers.cloudflare.com/workers/wrangler/configuration/#previews
					 */
				},
			};
		}
		default: {
			if (ctx.isPreview) {
				return {
					worker: {
						name: "example-worker",
						compatibilityDate: "2026-09-23",
						env: {
							MODE: bindings.text("preview"),
						},
					},
				};
			}
			return {
				worker: {
					name: "example-worker",
					compatibilityDate: "2026-09-23",
					env: {
						CACHE: bindings.kv({
							id: "production-cache",
						}),
						LOGS: bindings.logfwdr({
							destination: "logs",
						}),
					},
					/**
					 * TODO(@cloudflare): cf migrate: Preview configuration was converted to \`ctx.isPreview\` handling. Review the generated Preview branch.
					 * @see https://developers.cloudflare.com/workers/wrangler/configuration/#previews
					 */
				},
			};
		}
	}
});
",
  "codes": [
    "secret-files-not-migrated",
    "preview-review",
