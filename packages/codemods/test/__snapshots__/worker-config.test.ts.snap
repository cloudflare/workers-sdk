export default defineConfig({
	accountId: "account-id",
	worker: {
		name: "example-worker",
		compatibilityDate: "2026-09-23",
		compatibilityFlags: [
			"nodejs_compat",
		],
		entrypoint: "src/index.ts",
		observability: {
			enabled: true,
			headSamplingRate: 0.5,
		},
		assets: {
			htmlHandling: "auto-trailing-slash",
			notFoundHandling: "404-page",
		},
		domains: [
			"api.example.com",
		],
		triggers: [
			triggers.fetch({
				pattern: "example.com/*",
			}),
			triggers.scheduled({
				schedule: "0 * * * *",
			}),
			triggers.queue({
				maxBatchSize: 10,
				name: "jobs",
			}),
			triggers.connect({
				idleTimeoutMs: 5000,
				maxPendingBytes: 65536,
				port: 53,
				protocol: "udp",
			}),
			triggers.email({
				addresses: [],
			}),
		],
		env: {
			MODE: bindings.text("production"),
			CACHE: bindings.kv({
				id: "namespace-id",
			}),
		},
		exports: {
			Counter: exports.durableObject({
				storage: "sqlite",
			}),
			Entrypoint: exports.worker({
				cache: {
					enabled: true,
				},
			}),
			Workflow: exports.workflow({
				name: "example-workflow",
				limits: {
					steps: 10,
				},
				concurrency: {
					limit: 2,
				},
				schedules: [
					"0 * * * *",
					"30 * * * *",
				],
				defaultRetention: {
					errorRetention: 86400000,
					successRetention: "3 days",
				},
			}),
		},
		/**
