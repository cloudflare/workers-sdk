exports[`Wrangler Worker configuration conversion > merges a Workflow binding's settings into the export declaring the same Workflow 1`] = `
{
  "followUps": [],
  "output": "import { bindings, defineConfig, exports } from "cf/config";

export default defineConfig({
	worker: {
		name: "app",
		compatibilityDate: "2026-09-23",
		entrypoint: "src/index.ts",
		env: {
			JOBS: bindings.workflow({
				name: "jobs",
				worker: "app",
				exportName: "Jobs",
			}),
		},
		exports: {
			Jobs: exports.workflow({
				name: "jobs",
				limits: {
					steps: 10,
				},
				schedules: "0 * * * *",
			}),
		},
	},
});
",
}
`;

