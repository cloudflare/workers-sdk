exports[`migrateWranglerToCf > migrates preview-only Wrangler tooling without inheriting production defines > wrangler.config.ts 1`] = `
"import { defineWranglerConfig } from "wrangler/experimental-config";

export default defineWranglerConfig((ctx) => {
	switch (ctx.mode) {
		case "staging": {
			if (ctx.isPreview) {
				return {};
			}
			return {
				define: {
					PRODUCTION_ONLY: "\\"production\\"",
				},
			};
		}
		default: {
			if (ctx.isPreview) {
				return {
					define: {
						PREVIEW_ONLY: "\\"preview\\"",
					},
				};
			}
			return {};
		}
	}
});
"
`;

