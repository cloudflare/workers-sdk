exports[`migrateWranglerToCf > migrates Durable Object history without manual intervention with vite 1`] = `
"import { bindings, defineConfig, exports } from "cf/config";

export default defineConfig({
	worker: {
		name: "counter-worker",
		compatibilityDate: "2026-09-23",
		entrypoint: "src/index.ts",
		env: {
			COUNTER: bindings.durableObject({
				worker: "counter-worker",
				exportName: "Counter",
			}),
		},
		exports: {
			LegacyCounter: exports.durableObject({
				state: "deleted",
			}),
			OldCounter: exports.durableObject({
				renamedTo: "Counter",
				state: "renamed",
			}),
			Counter: exports.durableObject({
				storage: "sqlite",
			}),
		},
	},
});
"
`;

